{
  "manifest_version": 3,
  "name": "Doubao Dola 15-Second Watermark Remover",
  "version": "1.0.0",
  "description": "Supports 15-second configuration and extracts watermark-free image and video resources from Doubao and Dola.",
  "permissions": [
    "debugger",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "*://*.doubao.com/*",
    "*://*.dola.com/*",
    "*://*.byteintlapi.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.doubao.com/*",
        "*://*.dola.com/*"
      ],
      "js": [
        "content-panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Doubao Dola 15-Second Watermark Remover"
  }
}
